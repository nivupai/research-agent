GEMINI_API_KEY=
NCBI_API_KEY=
NCBI_EMAIL=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
SANDBOX_IMAGE=bioagent-sandbox:latest
SANDBOX_MEM=512m
SANDBOX_CPUS=1.0
SANDBOX_TIMEOUT_MAX=120
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# Optional per-role overrides, "provider:model":
# PLANNER_MODEL=gemini:gemini-3.5-flash
# SPECIALIST_MODEL=ollama:qwen3:4b
# SYNTH_MODEL=gemini:gemini-3.5-flash
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Generated locally; docker-compose reads it for the container's initial auth.
NEO4J_PASSWORD=
# NEO4J_QUERY_TIMEOUT_S=10
# Claim verification (needs `uv sync --extra models`); `bioagent ask --no-verify` disables it
# VERIFY_CLAIMS=true
# NLI_MODEL=MoritzLaurer/DeBERTa-v3-large-mnli-fever-anli-ling-wanli
# NLI_ENTAIL_THRESHOLD=0.5
# NLI_CONTRADICTION_THRESHOLD=0.5
# VERIFY_POLICY=remove
# LITERATURE_MODEL=gemini:gemini-3.5-flash
# VERIFIER_BACKEND=nli            # nli | small_lora | llm | router
# VERIFIER_ROUTER_THRESHOLD=0.75
# Serving (bioagent serve / bioagent worker; see README "Serving")
# REDIS_URL=redis://localhost:6379/0
# API_KEY=
# RATE_LIMIT_PER_MINUTE=30
# SEMANTIC_CACHE_THRESHOLD=0.95
# OTLP_ENDPOINT=http://localhost:4318
